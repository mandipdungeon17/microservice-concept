{
  "realm": "equitycart",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER", "description": "Default role for registered users", "composite": false, "clientRole": false
      },
      {
        "name": "SELLER", "description": "Product management access", "composite": false, "clientRole": false
      },
      {
        "name": "ADMIN", "description": "Administrative access", "composite": false, "clientRole": false
      },
      {
        "name": "SERVICE", "description": "Machine-to-machine service identity", "composite": false, "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-equitycart",
    "composite": true,
    "composites": {
      "realm": ["CUSTOMER"]
    }
  },
  "clients": [
    {
      "clientId": "equitycart-gateway",
      "name": "EquityCart API Gateway",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "gateway-secret",
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "userId-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "userId",
            "claim.name": "userId",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "equitycart-frontend",
      "name": "EquityCart Frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "userId-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "userId",
            "claim.name": "userId",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "equitycart-services",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "services-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "userId-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "userId",
            "claim.name": "userId",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer1",
      "email": "customer1@equitycart.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "Test@1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER", "default-roles-equitycart"
      ],
      "attributes": {
        "userId": [
          "1"
        ]
      }
    },
    {
      "username": "seller1",
      "email": "seller1@equitycart.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Seller",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "Test@1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SELLER", "default-roles-equitycart"
      ],
      "attributes": {
        "userId": [
          "2"
        ]
      }
    },
    {
      "username": "admin1",
      "email": "admin1@equitycart.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "Test@1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN", "default-roles-equitycart"
      ],
      "attributes": {
        "userId": [
          "3"
        ]
      }
    },
    {
      "username": "service-account-equitycart-services",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "equitycart-services",
      "realmRoles": ["SERVICE"]
    }
  ]
}